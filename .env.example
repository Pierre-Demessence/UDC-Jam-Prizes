# Copy to `.env` for local development — `.env` itself is gitignored.
#
# ADMIN_PASSWORD is the only login the app has: whoever knows it can edit the
# catalogue. SESSION_SECRET signs the session cookie; use a long random value
# (for example `node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"`).

ADMIN_PASSWORD=change-me
SESSION_SECRET=at-least-16-characters-long

# Optional
# PORT=3001
# DATABASE_PATH=data/prizes.sqlite
# NODE_ENV=production
#
# Pin the whole admin side — the login page included — to addresses you know.
# Comma-separated addresses, CIDR blocks or IPv6 literals. Empty or absent means
# the admin is reachable from anywhere (the password is then the only door).
# Local addresses stay allowed outside production, so dev cannot lock itself out.
# ADMIN_IP_ALLOWLIST=203.0.113.7,10.0.0.0/8
